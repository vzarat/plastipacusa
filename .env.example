# Assist AI. AI_PROVIDER defaults to openai when omitted.
# Use openai, or gemini / google. Do not wrap values in quotes.
# Gemini uses @ai-sdk/google. GEMINI_MODEL overrides the default gemini-2.5-flash.
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Storefront. Fill these in .env.local (gitignored). No quotes or surrounding spaces.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
RESEND_API_KEY=
ADMIN_NOTIFICATION_EMAIL=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_CHECKOUT_LINK=
